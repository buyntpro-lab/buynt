# Ejemplo de configuración para scripts de demo images
# COPIAR A .env.local Y LLENAR CON TUS VALORES REALES
# 
# IMPORTANTE: .env.local NO SE DEBE COMMITEAR A GITHUB
# Verifica que .gitignore incluya .env.local

# Obtén estos valores de: https://app.supabase.com → Settings → API

# URL del proyecto Supabase
SUPABASE_URL=https://xxxxx.supabase.co

# Service Role Key (⚠️ SECRETO - Nunca lo expongas)
# Obtén de Settings → API → Service Role Secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
